<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10191A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Re"
            android:textColor="#A5DFC5"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="음성 메모"
            android:textColor="#F2F7F4"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이 길에서 기억하고 싶은 순간을 남겨 보세요."
            android:textColor="#B8CAC4"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#20302F"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/status_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="녹음 대기 중"
                android:textColor="#F2F7F4"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="아래 버튼을 눌러 음성 메모를 시작하세요."
                android:textColor="#B8CAC4"
                android:textSize="16sp" />
        </LinearLayout>

        <Button
            android:id="@+id/start_speech_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#A5DFC5"
            android:minHeight="56dp"
            android:text="녹음 시작"
            android:textColor="#10261E"
            android:textSize="20sp" />
    </LinearLayout>
</ScrollView>
