<?xml version="1.0" encoding="utf-8"?>
<com.example.practice_pleos.ReRoadLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusableInTouchMode="true"
    android:layoutDirection="ltr">

    <!-- Tags are left, top, right, bottom coordinates in the 1700 × 1184 reference. -->

    <FrameLayout
        android:id="@+id/header_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="85,80,1620,158" />

    <FrameLayout
        android:id="@+id/logo_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="85,80,155,158" />

    <FrameLayout
        android:id="@+id/intro_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="85,207,550,300" />

    <FrameLayout
        android:id="@+id/main_content_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="85,334,1168,1111">

        <TextView
            android:id="@+id/pleos_location_text"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="#F4F7FA"
            android:padding="16dp"
            android:text="현재 위치 확인 중"
            android:textColor="#182438"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:layout_marginTop="96dp"
            android:padding="20dp">

            <ScrollView
                android:id="@+id/recall_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/recall_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/recall_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="#202630"
                        android:textSize="18sp" />
                </LinearLayout>
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/recall_previous"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="이전"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/recall_next"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="다음"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/passenger_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="1205,213,1621,746" />

    <FrameLayout
        android:id="@+id/passenger_list_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="1230,310,1595,646" />

    <FrameLayout
        android:id="@+id/search_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="625,213,1168,300" />

    <Button
        android:id="@+id/nav_home"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="1350,78,1415,160"
        android:backgroundTint="@null"
        android:text="홈"
        android:textColor="@android:color/transparent"
        android:stateListAnimator="@null"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp">
        <aapt:attr name="android:background">
            <ripple android:color="#33000000">
                <item android:id="@android:id/mask">
                    <shape>
                        <solid android:color="#FFFFFF" />
                        <corners android:radius="8dp" />
                    </shape>
                </item>
            </ripple>
        </aapt:attr>
    </Button>

    <Button
        android:id="@+id/nav_memories"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="1456,78,1521,160"
        android:backgroundTint="@null"
        android:text="추억"
        android:textColor="@android:color/transparent"
        android:stateListAnimator="@null"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp">
        <aapt:attr name="android:background">
            <ripple android:color="#33000000">
                <item android:id="@android:id/mask">
                    <shape>
                        <solid android:color="#FFFFFF" />
                        <corners android:radius="8dp" />
                    </shape>
                </item>
            </ripple>
        </aapt:attr>
    </Button>

    <Button
        android:id="@+id/nav_profile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="1558,78,1623,160"
        android:backgroundTint="@null"
        android:text="설정"
        android:textColor="@android:color/transparent"
        android:stateListAnimator="@null"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp">
        <aapt:attr name="android:background">
            <ripple android:color="#33000000">
                <item android:id="@android:id/mask">
                    <shape>
                        <solid android:color="#FFFFFF" />
                        <corners android:radius="8dp" />
                    </shape>
                </item>
            </ripple>
        </aapt:attr>
    </Button>

    <EditText
        android:id="@+id/search_input"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="711,224,1046,286"
        android:background="@android:color/transparent"
        android:hint="검색어를 입력해주세요."
        android:textColorHint="@android:color/transparent"
        android:textColor="#283340"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:singleLine="true"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:textSize="14sp" />

    <Button
        android:id="@+id/voice_search_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="1046,224,1096,286"
        android:backgroundTint="@null"
        android:text="음성 검색"
        android:textColor="@android:color/transparent"
        android:stateListAnimator="@null"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp">
        <aapt:attr name="android:background">
            <ripple android:color="#33000000">
                <item android:id="@android:id/mask">
                    <shape>
                        <solid android:color="#FFFFFF" />
                        <corners android:radius="12dp" />
                    </shape>
                </item>
            </ripple>
        </aapt:attr>
    </Button>

    <Button
        android:id="@+id/search_action_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="1096,224,1140,286"
        android:backgroundTint="@null"
        android:text="검색"
        android:textColor="@android:color/transparent"
        android:stateListAnimator="@null"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp">
        <aapt:attr name="android:background">
            <ripple android:color="#33000000">
                <item android:id="@android:id/mask">
                    <shape>
                        <solid android:color="#FFFFFF" />
                        <corners android:radius="12dp" />
                    </shape>
                </item>
            </ripple>
        </aapt:attr>
    </Button>

    <Button
        android:id="@+id/bluetooth_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="1534,240,1601,312"
        android:backgroundTint="@null"
        android:text="블루투스"
        android:textColor="@android:color/transparent"
        android:stateListAnimator="@null"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp">
        <aapt:attr name="android:background">
            <ripple android:color="#33000000">
                <item android:id="@android:id/mask">
                    <shape>
                        <solid android:color="#FFFFFF" />
                        <corners android:radius="10dp" />
                    </shape>
                </item>
            </ripple>
        </aapt:attr>
    </Button>

    <Button
        android:id="@+id/add_passenger_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="1230,653,1596,721"
        android:backgroundTint="@null"
        android:text="탑승 인원 추가"
        android:textColor="@android:color/transparent"
        android:stateListAnimator="@null"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp">
        <aapt:attr name="android:background">
            <ripple android:color="#33000000">
                <item android:id="@android:id/mask">
                    <shape>
                        <solid android:color="#FFFFFF" />
                        <corners android:radius="16dp" />
                    </shape>
                </item>
            </ripple>
        </aapt:attr>
    </Button>

    <TextView
        android:id="@+id/status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="1205,747,1621,787"
        android:gravity="center_vertical"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#202124"
        android:textSize="13sp" />

    <Button
        android:id="@+id/record_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="1204,788,1621,940"
        android:backgroundTint="@null"
        android:text="기억하기"
        android:textColor="@android:color/transparent"
        android:stateListAnimator="@null"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp">
        <aapt:attr name="android:background">
            <ripple android:color="#33000000">
                <item android:id="@android:id/mask">
                    <shape>
                        <solid android:color="#FFFFFF" />
                        <corners android:radius="29dp" />
                    </shape>
                </item>
            </ripple>
        </aapt:attr>
    </Button>

    <Button
        android:id="@+id/recall_button"
        android:layout_width="wrap_content"
            android:layout_height="wrap_content"
        android:tag="1204,960,1621,1112"
        android:backgroundTint="@null"
        android:text="회상하기"
        android:textColor="@android:color/transparent"
        android:stateListAnimator="@null"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp">
        <aapt:attr name="android:background">
            <ripple android:color="#33000000">
                <item android:id="@android:id/mask">
                    <shape>
                        <solid android:color="#FFFFFF" />
                        <corners android:radius="29dp" />
                    </shape>
                </item>
            </ripple>
        </aapt:attr>
    </Button>

</com.example.practice_pleos.ReRoadLayout>
